<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_chat_canvas"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="18dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical"
        android:background="#F8FAFF"
        android:elevation="3dp"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_agent_avatar"
            android:padding="9dp"
            android:src="@drawable/ic_lucide_sparkles"
            android:tint="#FFFFFF"
            android:contentDescription="EduAgent" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EduAgent · 0.6"
                android:textColor="#1C2642"
                android:textStyle="bold"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/engine_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preparando IA local..."
                android:textColor="#6B7894"
                android:textSize="12sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/model_info"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_lucide_brain"
            android:tint="#4E60A0"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Gerenciar modelos locais" />
        <ImageView
            android:id="@+id/settings_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#E8EDFC"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_lucide_settings"
            android:tint="#4E60A0"
            android:contentDescription="Configurações da IA" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/download_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:padding="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_download_card"
        android:elevation="2dp"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sua IA, direto neste celular"
            android:textColor="#233A72"
            android:textStyle="bold"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/download_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Baixe o Qwen2.5 3B uma única vez (cerca de 2,1 GB). Depois, o chat funciona sem internet."
            android:textColor="#53688C"
            android:textSize="13sp" />
        <ProgressBar
            android:id="@+id/download_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="12dp"
            android:progressTint="#526EE3"
            android:progressBackgroundTint="#D8E2FF"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/download_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Baixar modelo"
            app:icon="@drawable/ic_lucide_download"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="18dp"
            android:paddingBottom="16dp"
            android:scrollbars="none" />
        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:orientation="vertical">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="5dp"
                android:src="@drawable/ic_lucide_sparkles"
                android:tint="#5169DD"
                android:contentDescription="" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="O que vamos descobrir hoje?"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textColor="#273856"
                android:textSize="19sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Seu espaço para perguntar, aprender e explorar com uma IA que funciona no dispositivo."
                android:textAlignment="center"
                android:textColor="#7482A0"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FAFBFF"
        android:elevation="5dp">
        <LinearLayout
            android:id="@+id/attachment_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="17dp"
            android:paddingTop="8dp"
            android:paddingEnd="17dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/selected_image"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerCrop"
                android:contentDescription="Imagem selecionada" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Imagem para @VLM"
                android:textColor="#53688C"
                android:textSize="13sp" />
            <ImageView
                android:id="@+id/remove_attachment"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="12dp"
                android:src="@drawable/ic_lucide_x"
                android:tint="#53688C"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Remover imagem" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">
            <ImageButton
                android:id="@+id/attach_button"
                android:layout_gravity="center_vertical"
                android:layout_width="46dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_composer_action"
                android:padding="12dp"
                android:src="@drawable/ic_lucide_plus"
                android:tint="#526EE3"
                android:scaleType="centerInside"
                android:contentDescription="Escolher imagem do celular"
                />
            <EditText
                android:id="@+id/user_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:minLines="1"
                android:maxLines="4"
                android:paddingStart="17dp"
                android:paddingEnd="17dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:background="@drawable/bg_composer"
                android:gravity="center_vertical"
                android:inputType="textCapSentences|textMultiLine"
                android:imeOptions="actionSend"
                android:hint="Mensagem"
                android:textColor="#273552"
                android:textColorHint="#92A0B8"
                android:textSize="15sp" />
            <ImageButton
                android:id="@+id/voice_bubble_button"
                android:layout_gravity="center_vertical"
                android:layout_width="46dp"
                android:layout_height="52dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_composer_action"
                android:padding="12dp"
                android:src="@drawable/ic_lucide_mic"
                android:tint="#526EE3"
                android:scaleType="centerInside"
                android:contentDescription="Ativar assistente flutuante com voz"
                />
            <ImageButton
                android:id="@+id/send_button"
                android:layout_gravity="center_vertical"
                android:layout_width="54dp"
                android:layout_height="52dp"
                android:layout_marginStart="9dp"
                android:background="@drawable/bg_composer_send"
                android:padding="14dp"
                android:src="@drawable/ic_lucide_send"
                android:tint="#FFFFFF"
                android:scaleType="centerInside"
                android:contentDescription="Enviar mensagem"
                />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="7dp"
            android:textAlignment="center"
            android:text="IA local pode cometer erros. Confira informações importantes."
            android:textSize="10sp"
            android:textColor="#9CA7BE" />
    </LinearLayout>
</LinearLayout>
